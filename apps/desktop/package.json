{
  "name": "stellar-toml-lint-desktop",
  "productName": "Stellar TOML Lint",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app that watches a folder for stellar.toml changes and raises native alerts when a change introduces an error.",
  "license": "Apache-2.0",
  "author": "anchor-tools <anchortools23@gmail.com> (https://github.com/anchor-tools)",
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-preload.mjs",
    "start": "npm run build && electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "make:dmg": "npm run build && electron-forge make --targets @electron-forge/maker-dmg",
    "make:msi": "npm run build && electron-forge make --targets @electron-forge/maker-wix",
    "make:appimage": "npm run build && electron-forge make --targets @reforged/maker-appimage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "stellar-toml-lint": "file:../.."
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-wix": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@reforged/maker-appimage": "^5.0.0",
    "electron": "^33.2.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2"
  }
}
