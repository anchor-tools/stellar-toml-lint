# Maintainer: anchor-tools <anchortools23@gmail.com>
pkgname=stellar-toml-lint
pkgver=0.1.0
pkgrel=1
pkgdesc="Offline SEP-1 linter for stellar.toml — validate your Stellar Info File before you deploy it"
arch=('any')
url="https://github.com/anchor-tools/stellar-toml-lint"
license=('Apache-2.0')
depends=('nodejs')
makedepends=('npm')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/anchor-tools/stellar-toml-lint/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  npm ci
}

build() {
  cd "${pkgname}-${pkgver}"
  npm run build
}

check() {
  cd "${pkgname}-${pkgver}"
  npm test
}

package() {
  cd "${pkgname}-${pkgver}"

  # Install the main package to /usr/lib/node_modules
  install -dm755 "${pkgdir}/usr/lib/node_modules/${pkgname}"
  cp -r dist package.json README.md LICENSE "${pkgdir}/usr/lib/node_modules/${pkgname}/"

  # Create the binary wrapper
  install -dm755 "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/${pkgname}" <<'EOF'
#!/usr/bin/env sh
exec node /usr/lib/node_modules/stellar-toml-lint/dist/cli.js "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/${pkgname}"

  # Install man page
  install -dm755 "${pkgdir}/usr/share/man/man1"
  cat > "${pkgdir}/usr/share/man/man1/${pkgname}.1" <<'EOF'
.\" DO NOT MODIFY THIS FILE!  It was generated by help2man.
.TH STELLAR-TOML-LINT "1" "September 2025" "stellar-toml-lint 0.1.0" "User Commands"
.SH NAME
stellar-toml-lint \- Validate a Stellar Info File (stellar.toml) against SEP-1
.SH SYNOPSIS
.B stellar-toml-lint
[\fIfile\fR...]
.RI [ \fB\-d\fR \fIdomain\fR ]
.RI [ \fB\-f\fR \fIformat\fR ]
.RB [ \-\-strict ]
.RB [ \-\-max-warnings\fR \fIn\fR ]
.RB [ \-\-off\fR \fIrule\fR ]...
.RB [ \-\-error\fR \fIrule\fR ]...
.RB [ \-\-warn\fR \fIrule\fR ]...
.RB [ \-i | \-\-interactive ]
.RB [ \-q | \-\-quiet ]
.RB [ \-\-show-help-urls ]
.RB [ \-\-no-suggestions ]
.RB [ \-\-check-network ]
.RB [ \-\-check-contracts ]
.RI [ \-\-soroban-rpc\fR \fIurl\fR ]
.RI [ \-\-webhook-slack\fR \fIurl\fR ]
.RI [ \-\-webhook-discord\fR \fIurl\fR ]
.RI [ \-\-badge-svg\fR \fIfile\fR ]
.RI [ \-\-badge-json\fR \fIfile\fR ]
.RB [ \-\-export-ap-config ]
.RI [ \-\-generate-openapi\fR \fIfile\fR ]
.RB [ \-\-color | \-\-no-color ]
.RB [ \-\-list-rules ]
.RB [ \-v | \-\-version ]
.RB [ \-h | \-\-help ]
.SH DESCRIPTION
.B stellar-toml-lint
validates a Stellar Info File (\fIstellar.toml\fR) against SEP-1 offline.
.SH OPTIONS
.TP
\fB\-d\fR, \fB\-\-domain\fR=\fIdomain\fR
Domain serving the file. Enables CORS, content-type and ORG_URL same-domain checks.
Fetches unless files are given.
.TP
\fB\-f\fR, \fB\-\-format\fR=\fIformat\fR
Output format: \fItext\fR (default), \fIjson\fR, \fIsarif\fR, \fIgithub\fR, or \fIjunit\fR.
.TP
\fB\-\-strict\fR
Treat warnings as errors.
.TP
\fB\-\-max-warnings\fR=\fIn\fR
Fail if warnings exceed \fIn\fR.
.TP
\fB\-\-off\fR=\fIrule\fR
Disable a rule (repeatable).
.TP
\fB\-\-error\fR=\fIrule\fR
Raise a rule to error (repeatable).
.TP
\fB\-\-warn\fR=\fIrule\fR
Lower a rule to warning (repeatable).
.TP
\fB\-i\fR, \fB\-\-interactive\fR
Full-screen dashboard to walk the findings. Needs a TTY.
.TP
\fB\-q\fR, \fB\-\-quiet\fR
Report errors only.
.TP
\fB\-\-show-help-urls\fR
Print the spec link for each finding.
.TP
\fB\-\-no-suggestions\fR
Hide diagnostic suggestions in the output.
.TP
\fB\-\-check-network\fR
Verify SIGNING_KEY, ACCOUNTS, HORIZON_URL, SEP-8 regulated issuer flags,
and ANCHOR_QUOTE_SERVER against the network.
.TP
\fB\-\-check-contracts\fR
Verify Soroban contract and WASM TTL liveliness.
.TP
\fB\-\-soroban-rpc\fR=\fIurl\fR
Soroban RPC endpoint to use with \-\-check-contracts.
.TP
\fB\-\-webhook-slack\fR=\fIurl\fR
POST a Slack Block Kit card with the run summary.
.TP
\fB\-\-webhook-discord\fR=\fIurl\fR
POST a Discord embed with the run summary.
.TP
\fB\-\-badge-svg\fR=\fIfile\fR
Generate an SVG compliance badge.
.TP
\fB\-\-badge-json\fR=\fIfile\fR
Generate a Shields.io JSON endpoint.
.TP
\fB\-\-export-ap-config\fR
Export Anchor Platform YAML config to stdout.
.TP
\fB\-\-generate-openapi\fR=\fIfile\fR
Generate an OpenAPI 3.1 spec (json or yaml extension).
.TP
\fB\-\-color\fR / \fB\-\-no-color\fR
Force colour on or off.
.TP
\fB\-\-list-rules\fR
Print every rule and exit.
.TP
\fB\-v\fR, \fB\-\-version\fR
Print version and exit.
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help and exit.
.SH EXIT STATUS
.TP
0
No errors.
.TP
1
Errors found.
.TP
2
Bad usage or I/O failure.
.SH EXAMPLES
.TP
Lint a local file:
stellar-toml-lint public/.well-known/stellar.toml
.TP
Fetch and lint a live site:
stellar-toml-lint --domain example.com --strict
.TP
Generate SARIF for GitHub code scanning:
stellar-toml-lint -f sarif > results.sarif
.SH AUTHOR
anchor-tools <anchortools23@gmail.com>
.SH SEE ALSO
The full documentation is available at:
https://github.com/anchor-tools/stellar-toml-lint
EOF
  gzip -f "${pkgdir}/usr/share/man/man1/${pkgname}.1"

  # Install license
  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  cp LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/"
}